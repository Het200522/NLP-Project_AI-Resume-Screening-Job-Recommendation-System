# Docker Compose configuration.
# Copy to .env in this directory and adjust before running `docker compose up --build`.

# URL the BROWSER uses to reach the backend. It is baked into the frontend bundle
# at build time, so it must be reachable from the user's machine, not from inside
# the Docker network. Use the host's LAN IP or domain when not on localhost,
# and do not prefix a Docker service name here.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Browser origins allowed to call the API. Comma-separated, no spaces required.
# Must include the origin you actually open the frontend on, or the browser will
# block the responses and lists (e.g. the role dropdown) will appear empty.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
